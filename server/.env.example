# Copy to server/.env and fill in. Never commit the real .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog?retryWrites=true&w=majority
JWT_SECRET=<run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))">
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
